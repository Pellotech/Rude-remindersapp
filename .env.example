# Rude Reminders App - Environment Variables Template
# 
# After downloading this project, follow these steps:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and add your actual API keys
# 3. Run: npm install && npm run build && npx cap sync ios
#
# Get your Stripe keys from: https://dashboard.stripe.com/apikeys

# Stripe Configuration (Required)
# Backend secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_live_your_secret_key_here

# Frontend publishable key (starts with pk_test_ or pk_live_)
VITE_STRIPE_PUBLIC_KEY=pk_live_your_publishable_key_here

# Note: Both keys must be from the same environment (test or live)

# Optional: Other environment variables your app might use
# DATABASE_URL=your_database_url_if_needed
# REPLIT_DB_URL=automatically_set_in_replit